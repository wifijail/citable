# =============================================================================
#  Citable — environment variables
# =============================================================================
#  Local development: copy this file to `.env.local` and fill in what you need.
#  Vercel: Project → Settings → Environment Variables (same names, no quotes),
#  then Redeploy — NEXT_PUBLIC_* values are baked in at build time.
#  NEVER commit a filled-in file. Step-by-step guide in Russian: SETUP_RU.md
# =============================================================================

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Security -------------------------------------------------------------------
# Signs license keys issued by the site (manual approvals, Stripe/Lemon Squeezy).
# At least 16 random characters. Changing it later invalidates keys already issued.
# Not needed for Gumroad keys, which Gumroad issues and verifies.
LICENSE_SECRET=
# Password for /ru/admin (at least 10 characters).
ADMIN_PASSWORD=
# Optional. Vercel sends it to the daily cleanup job (vercel.json → /api/cron/cleanup).
CRON_SECRET=

# --- Database (Postgres) ----------------------------------------------------------
# Without it data lives in server memory and is lost on restart.
# Kazakhstan: personal data must be stored on servers in Kazakhstan (Law 94-V, Art. 12).
DATABASE_URL=

# --- Payments ------------------------------------------------------------------------
# Option 1 — Gumroad (automatic). Create a product per plan with
# "Generate a unique license key per sale" switched on.
# Product id: Gumroad → product → Content → License key section.
GUMROAD_PRODUCT_ID_PRO=
GUMROAD_URL_PRO=
GUMROAD_PRODUCT_ID_AGENCY=
GUMROAD_URL_AGENCY=
GUMROAD_PRODUCT_ID_LIFETIME=
GUMROAD_URL_LIFETIME=

# Option 2 — any payment link (Boosty, Patreon, Tribute…). Buyers pay there, send a
# form, and you approve the payment in /admin. Needs LICENSE_SECRET.
PAYMENT_PLATFORM_NAME=Boosty
PAYMENT_LINK_PRO=
PAYMENT_LINK_AGENCY=
PAYMENT_LINK_LIFETIME=

# Option 3 — Lemon Squeezy / Stripe (not available in every country).
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_AGENCY=
LEMONSQUEEZY_VARIANT_LIFETIME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_LIFETIME=

# The first fully configured option wins (Gumroad → links → Lemon Squeezy → Stripe).
# Force one with: gumroad | external | lemonsqueezy | stripe
PAYMENT_PROVIDER=

# Optional prices in tenge shown next to the dollar price (Kazakhstan consumer law).
NEXT_PUBLIC_PRICE_KZT_PRO=
NEXT_PUBLIC_PRICE_KZT_AGENCY=
NEXT_PUBLIC_PRICE_KZT_LIFETIME=

# --- Email (Resend) ------------------------------------------------------------------
# Sends keys, rejection notices and owner notifications. Optional.
RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAIL=

# --- Your public details (empty = not shown) --------------------------------------------
NEXT_PUBLIC_BRAND_NAME=Citable
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_CONTACT_SOCIAL_URL=
NEXT_PUBLIC_CONTACT_RESPONSE_TIME=

# --- Seller identity (About page, footer, legal documents) --------------------------------
# e.g. "ИП Иванов Иван Иванович"
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
# ИИН/БИН
NEXT_PUBLIC_LEGAL_REG_NUMBER=
# e.g. "Уведомление о начале деятельности ИП от 01.10.2026"
NEXT_PUBLIC_LEGAL_REG_DETAILS=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_COUNTRY=
# Where the database physically is, e.g. "Казахстан, Алматы (ps.kz)"
NEXT_PUBLIC_DATA_LOCATION=
NEXT_PUBLIC_REFUND_DAYS=14
NEXT_PUBLIC_LEGAL_UPDATED=2026-09-15

# --- Scanner tuning ---------------------------------------------------------------------
FREE_DAILY_SCAN_LIMIT=5
FETCH_TIMEOUT_MS=10000
