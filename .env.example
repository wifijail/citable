# =============================================================================
#  Citable — environment variables
# =============================================================================
#  Local development: copy this file to `.env.local` and fill in what you need.
#  Vercel: Project → Settings → Environment Variables (same names, no quotes).
#  NEVER commit a filled-in file. Step-by-step guide in Russian: SETUP_RU.md
#
#  Everything is optional for a first deploy — the site builds and runs with
#  zero variables. Each block says what stops working without it.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Public address, used for canonical links, sitemap and payment redirects.
# On Vercel it falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=

# --- Security (set these two before going live) ---------------------------------
# Signs license keys. At least 16 random characters: `openssl rand -hex 32`.
# Without it: checkout is disabled and no keys can be issued or verified.
# Changing it later invalidates every key already sold — pick once, keep safe.
LICENSE_SECRET=

# Password for /en/admin (at least 10 characters).
# Without it: the admin panel is switched off.
ADMIN_PASSWORD=

# --- Database (Postgres: Neon or Supabase free tier) -----------------------------
# Without it: scans, leads, messages and licenses live in server memory and are
# LOST on every restart. Fine for trying locally, not for real customers.
# The Neon Vercel integration sets DATABASE_URL for you. Tables are created
# automatically on the first request.
DATABASE_URL=

# --- Payments: Lemon Squeezy (recommended — handles worldwide VAT for you) --------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant ids of the three products (Products → a product → variant id).
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_AGENCY=
LEMONSQUEEZY_VARIANT_LIFETIME=

# --- Payments: Stripe (alternative) ---------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_LIFETIME=

# If both providers are configured, Lemon Squeezy is used. Force one with:
# PAYMENT_PROVIDER=stripe

# --- Email (Resend, free tier 3,000/month) ---------------------------------------
# Sends license keys to buyers and forwards contact-form messages to you.
# Without it: buyers still see their key on screen; messages stay in the admin panel.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. Citable <hello@yourdomain.com>
EMAIL_FROM=
# Where contact-form notifications go (defaults to NEXT_PUBLIC_CONTACT_EMAIL).
OWNER_EMAIL=

# --- Your public details (shown on the site; empty = hidden) ---------------------
NEXT_PUBLIC_BRAND_NAME=Citable
NEXT_PUBLIC_CONTACT_EMAIL=
# Telegram username without @
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_CONTACT_SOCIAL_URL=
NEXT_PUBLIC_CONTACT_RESPONSE_TIME=

# --- Legal identity (Terms / Privacy / Refund pages) -----------------------------
# Payment providers check these pages when approving your store.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_COUNTRY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REG_NUMBER=
NEXT_PUBLIC_REFUND_DAYS=14
NEXT_PUBLIC_LEGAL_UPDATED=2026-09-13

# --- Scanner tuning ---------------------------------------------------------------
FREE_DAILY_SCAN_LIMIT=5
FETCH_TIMEOUT_MS=10000
