# ---------------------------------------------------------------------------
# Citable — environment variables
# Copy to `.env.local` for development. NEVER commit the filled-in file.
# The app runs fully without any of these (payments + persistence degrade
# gracefully), so you can develop and demo with zero configuration.
# ---------------------------------------------------------------------------

# Public base URL, used for Stripe redirects and canonical metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Licensing (required for paid features to be verifiable) ---------------
# Any long random string. Generate with:  openssl rand -hex 32
# License keys are HMAC-signed with this secret, so no database is needed.
LICENSE_SECRET=dev-insecure-secret-change-me

# --- Stripe (optional; checkout falls back to a waitlist CTA if unset) ------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_LIFETIME=

# --- Lead capture (optional) -----------------------------------------------
# If set, submitted emails are POSTed here (Zapier / Make / Formspree / n8n).
LEAD_WEBHOOK_URL=

# --- Scanner tuning (optional) ---------------------------------------------
# Requests per IP per day on the free plan.
FREE_DAILY_SCAN_LIMIT=5
# Per-request network timeout, ms.
FETCH_TIMEOUT_MS=10000
